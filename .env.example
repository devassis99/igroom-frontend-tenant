# Base URL of igroom-backend, no trailing slash. Not read by anything yet —
# igroom-backend has no tenant/shop-owner endpoints (auth, bookings, staff,
# etc.) as of this scaffold, so the whole app runs on sample data and a
# client-only mock session. Kept here, and in src/lib/env.ts + http.ts, so
# wiring up the real API later is a drop-in instead of a restructure.
VITE_API_BASE_URL=http://localhost:3000
