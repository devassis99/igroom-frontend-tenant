# Base URL of igroom-backend, no trailing slash.
VITE_API_BASE_URL=http://localhost:3000

# Same Google Cloud Console OAuth 2.0 Client ID as igroom-backend's
# GOOGLE_CLIENT_ID (Web application type) — used client-side by Google
# Identity Services to obtain an ID token; the backend verifies that
# token was issued for this exact client before trusting it.
# Google Cloud Console → APIs & Services → Credentials → your OAuth
# client → Authorized JavaScript origins must include this app's origin
# (e.g. http://localhost:5174 for local dev).
VITE_GOOGLE_CLIENT_ID=

# Stripe publishable key from Dashboard → Developers → API keys. Must be
# from the SAME Stripe account/mode as igroom-backend's STRIPE_SECRET_KEY
# — a pk_test_ key with an sk_live_ backend (or vice versa) fails at
# card confirmation with an unhelpful "No such setupintent" error.
VITE_STRIPE_PUBLISHABLE_KEY=

# Public booking site origin. Locations > QR encodes <base>/l/<locationId>.
# Optional — leave unset until that site exists; the QR panel will say it
# has nowhere to point rather than printing a dead code.
VITE_BOOKING_BASE_URL=https://book.igroom.io
